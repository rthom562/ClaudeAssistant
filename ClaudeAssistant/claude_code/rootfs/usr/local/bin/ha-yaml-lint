#!/usr/bin/env bash
# Syntax-check Home Assistant YAML with yamllint (relaxed rules).
# HA-specific tags such as !include, !secret and !input are accepted.
#
#   ha-yaml-lint                 lint top-level /config/*.yaml
#   ha-yaml-lint FILE|DIR ...    lint the given files/directories
#
# This checks YAML syntax only. Home Assistant's own validation is still
# required: Developer tools > YAML > Check configuration.

set -uo pipefail

CONFIG='{extends: relaxed, rules: {line-length: disable, truthy: disable, comments: disable, document-start: disable, empty-lines: {max: 3}}}'

if [ $# -eq 0 ]; then
    shopt -s nullglob
    set -- /config/*.yaml
fi
exec yamllint -f colored -d "${CONFIG}" "$@"
