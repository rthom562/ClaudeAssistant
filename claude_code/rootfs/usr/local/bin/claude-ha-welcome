#!/usr/bin/env bash
# Short banner shown when a terminal opens.

access="$(cat /etc/claude-code/ha-config-access 2>/dev/null || echo unknown)"
skip="$(sed -n 's/^skip_permissions=//p' /etc/claude-code/ha-tab-flags 2>/dev/null)"
version="$(claude --version 2>/dev/null | head -n 1)"
if [ -f /data/home/.claude/.credentials.json ]; then
    login="signed in"
else
    login="not signed in - run: claude   (then follow the login prompt)"
fi

cat <<EOF

  Claude Code for Home Assistant
  ----------------------------------------------------------------
  Claude Code     : ${version:-not found}
  Login           : ${login}
  /config access  : ${access}   (change in the app's Configuration tab)
  Skip permissions: ${skip:-unknown} (New/Resume tabs)

  +  (tab bar)         New / Resume / Shell tab
  claude              start Claude Code in the current directory
  claude --continue   continue the most recent session here
  claude --resume     pick an earlier session to resume
  ha-claude           cd /config && claude
  tmux ls             list tab sessions (attach: tmux attach -t <name>)
  ha-git-init         put /config under git (asks first)
  ha-yaml-lint        syntax-check YAML files
  ha-config-backups   list / restore pre-edit copies of /config files

  /config           Home Assistant configuration (live!)
  /data/workspace   your projects and repositories (also ~/workspace)

  Claude Code cannot restart Home Assistant. After changes, use
  Developer tools > YAML > Check configuration, then reload/restart.
  ----------------------------------------------------------------

EOF
