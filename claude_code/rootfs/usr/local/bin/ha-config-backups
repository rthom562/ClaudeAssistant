#!/usr/bin/env bash
# List or restore the pre-edit copies made by ha-backup-hook.
#
#   ha-config-backups list [filter]
#   ha-config-backups diff <snapshot> <path-relative-to-/config>
#   ha-config-backups restore <snapshot> <path-relative-to-/config>
#
# Restore always asks for confirmation and first saves the current file as a
# new snapshot, so a restore can itself be undone.

set -euo pipefail
ROOT=/data/backups/config

usage() {
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
}

cmd="${1:-list}"
case "${cmd}" in
    list)
        filter="${2:-}"
        [ -d "${ROOT}" ] || { echo "No backups yet."; exit 0; }
        found=0
        while IFS= read -r f; do
            snap="${f#${ROOT}/}"; snap="${snap%%/*}"
            rel="${f#${ROOT}/${snap}/}"
            if [ -z "${filter}" ] || [[ "${rel}" == *"${filter}"* ]]; then
                printf '%-30s  %s\n' "${snap}" "${rel}"
                found=1
            fi
        done < <(find "${ROOT}" -type f | sort)
        [ "${found}" -eq 1 ] || echo "No matching backups."
        ;;
    diff)
        [ $# -eq 3 ] || usage
        src="${ROOT}/$2/$3"
        [ -f "${src}" ] || { echo "Not found: ${src}"; exit 1; }
        diff -u --label "backup $2/$3" --label "/config/$3" "${src}" "/config/$3" || true
        ;;
    restore)
        [ $# -eq 3 ] || usage
        src="${ROOT}/$2/$3"
        dst="/config/$3"
        [ -f "${src}" ] || { echo "Not found: ${src}"; exit 1; }
        echo "Restore ${dst}"
        echo "   from ${src} ?"
        read -r -p "Type 'yes' to continue: " answer
        [ "${answer}" = "yes" ] || { echo "Cancelled."; exit 1; }
        if [ -f "${dst}" ]; then
            keep="${ROOT}/$(date +%Y%m%d-%H%M%S-%N)-pre-restore/$3"
            mkdir -p "$(dirname -- "${keep}")"
            cp -p -- "${dst}" "${keep}"
            echo "Current version saved to ${keep}"
        fi
        mkdir -p "$(dirname -- "${dst}")"
        cp -p -- "${src}" "${dst}"
        echo "Restored. Check the configuration in Home Assistant, then reload/restart yourself."
        ;;
    *) usage ;;
esac
