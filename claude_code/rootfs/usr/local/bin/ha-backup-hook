#!/usr/bin/env bash
# Claude Code PreToolUse hook (registered in managed settings by run.sh).
#
# Before Claude's Edit/Write/MultiEdit/NotebookEdit tools change a file under
# /config, copy the current version to:
#   /data/backups/config/<timestamp>/<path relative to /config>
#
# Never blocks the edit (always exits 0), never prints file contents.
# Changes made through shell commands (sed, git, ...) are NOT covered; use git.

set -u

input="$(cat)"
file="$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"${input}" 2>/dev/null)"
[ -n "${file}" ] || exit 0

real="$(realpath -m -- "${file}" 2>/dev/null)" || exit 0
case "${real}" in
    /config/*) ;;
    *) exit 0 ;;
esac
[ -f "${real}" ] || exit 0      # new file: nothing to back up

stamp="$(date +%Y%m%d-%H%M%S-%N)"
dest="/data/backups/config/${stamp}/${real#/config/}"
mkdir -p "$(dirname -- "${dest}")" || exit 0
if cp -p -- "${real}" "${dest}"; then
    printf '%s\t%s\t%s\n' "$(date -Is)" "${real}" "${dest}" >> /data/backups/backup.log
fi
exit 0
