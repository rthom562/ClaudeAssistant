#!/usr/bin/env python3
"""Tab service for the Claude Code browser UI.

Each browser tab is a detached tmux session named "cc-<hex>". This service
(listening on 127.0.0.1 only, reached through nginx/Ingress) lists, creates
and closes those sessions. ttyd only *attaches* to an existing session
(claude-tab-attach), so reloading the page or reconnecting never starts a
second Claude process, and the same tabs appear on every device.

  GET  /api/tabs                 -> [{name, label, mode, state, order, custom}]
                                    state: working | done | ended | shell
  POST /api/tabs  {"mode": m}    -> create (m = new | resume | shell)
  POST /api/tabs/<name>/close    -> end that session
  POST /api/tabs/<name>/rename {"label": "..."}   ("" = automatic name again)
  POST /api/tabs/<name>/keys   {"key": "esc|tab|shift-tab|up|down|left|right|ctrl-c|enter"}
  GET  /api/info                 -> {"phone_url": "..."}
  GET  /api/qr?text=<url>        -> QR code (SVG) for an http(s) URL

POST requests must carry "X-Requested-With: claude-tabs" (blocks cross-site
form posts; Ingress already requires an authenticated HA admin session).
"""
import json
import os
import re
import socket
import subprocess
import threading
from urllib.parse import parse_qs, urlparse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LISTEN = ("127.0.0.1", 7682)
CWD = "/config"
NAME_RE = re.compile(r"^cc-[a-f0-9]{10}$")
SKIP_PERMISSIONS = os.environ.get("CC_SKIP_PERMISSIONS") == "true"
REMOTE_CONTROL = os.environ.get("CC_REMOTE_CONTROL") == "true"
MODES = ("new", "resume", "shell")
PHONE_URL = os.environ.get("CC_PHONE_URL", "").strip().rstrip("/")
if not re.fullmatch(r"https?://[^\s/]+", PHONE_URL):
    PHONE_URL = ""
URL_RE = re.compile(r"^https?://[^\s]{1,600}$")
KEYS = {
    "esc": "Escape", "tab": "Tab", "shift-tab": "BTab", "up": "Up", "down": "Down",
    "left": "Left", "right": "Right", "ctrl-c": "C-c", "enter": "Enter",
}
LOCK = threading.Lock()


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=15)


SEP = "\t"  # tmux escapes control characters other than tab in -F output
FIELDS = ["name", "created", "mode", "state", "title", "custom", "custom_label",
          "order", "pane_title", "pane_cmd"]
FORMAT = SEP.join([
    "#{session_name}", "#{session_created}", "#{@cc_mode}", "#{@cc_state}",
    "#{@cc_title}", "#{@cc_custom}", "#{@cc_label}", "#{@cc_order}",
    "#{pane_title}", "#{pane_current_command}",
])
BASE_LABEL = {"new": "Claude", "resume": "Resume", "shell": "Shell"}
HOSTNAME = socket.gethostname()
# Claude Code prefixes its terminal title with a status glyph (spinner, star).
LEADING_JUNK = re.compile(r"^[^0-9A-Za-z\u00C0-\uFFFF]+|^[\u2800-\u28FF\u2720-\u274F\u00B7\u2022\u25CF\u25CB\u2731-\u273D*·•\s]+")
GENERIC_TITLES = {"", "claude", "claude code", "bash", "sh", "tmux", "root", HOSTNAME.lower()}


def clean_title(text):
    text = re.sub(r"[\x00-\x1f\x7f]", "", text or "").strip()
    previous = None
    while text and text != previous:          # strip any number of leading glyphs
        previous = text
        text = LEADING_JUNK.sub("", text).strip()
    if text.lower() in GENERIC_TITLES or re.match(r"^[\w.-]+@[\w.-]+", text):
        return ""
    return text[:60]


def tab_label(t):
    if t["custom"] == "1" and t["custom_label"]:
        return t["custom_label"]                       # renamed by hand
    if t["mode"] == "shell":
        return BASE_LABEL["shell"]
    # The chat's name: a /rename title or summary from the transcript (set by
    # the state hook), else the terminal title Claude Code sets for the chat.
    return clean_title(t["title"]) or clean_title(t["pane_title"]) or BASE_LABEL.get(t["mode"], "Claude")


def tab_state(t):
    if t["mode"] == "shell":
        return "shell"
    if t["state"] in ("working", "done", "ended"):
        return t["state"]                    # reported by Claude Code's hooks
    return "done"   # started, waiting for the first prompt


def list_tabs():
    result = tmux("list-sessions", "-F", FORMAT)
    if result.returncode != 0:  # no tmux server yet = no tabs
        return []
    tabs = []
    for line in result.stdout.splitlines():
        parts = line.split(SEP)
        if len(parts) != len(FIELDS) or not NAME_RE.match(parts[0]):
            continue
        t = dict(zip(FIELDS, parts))
        tabs.append({
            "name": t["name"],
            "created": int(t["created"]) if t["created"].isdigit() else 0,
            "order": int(t["order"]) if t["order"].isdigit() else 0,
            "mode": t["mode"] or "new",
            "label": tab_label(t),
            "state": tab_state(t),
            "custom": t["custom"] == "1",
        })
    tabs.sort(key=lambda x: (x["order"], x["created"], x["name"]))
    return tabs


def next_order():
    return max([t["order"] for t in list_tabs()] + [0]) + 1


def claude_command(mode):
    args = ["claude"]
    if SKIP_PERMISSIONS:
        args.append("--dangerously-skip-permissions")
    if mode == "resume":
        args.append("--resume")
    if REMOTE_CONTROL:
        args.append("--remote-control")
    return " ".join(args)


def create_tab(mode):
    if mode not in MODES:
        raise ValueError("mode must be new, resume or shell")
    with LOCK:
        name = "cc-" + os.urandom(5).hex()
        label = BASE_LABEL[mode]
        order = next_order()
        if mode == "shell":
            inner = "exec bash --login"
        else:
            # "trap : INT" keeps this wrapper alive if Claude is stopped with
            # Ctrl-C (a handler, not an ignore, so Claude still gets Ctrl-C).
            inner = (
                f"trap : INT; {claude_command(mode)}; trap - INT; echo; "
                "echo 'Claude Code exited. This tab is now a shell - type exit to close it.'; "
                "exec bash --login"
            )
        args = ["new-session", "-d", "-s", name, "-c", CWD, "-x", "200", "-y", "50"]
        if SKIP_PERMISSIONS and mode != "shell":
            # Claude Code refuses bypass mode as root unless it is told it
            # runs in a sandbox. Scoped to this tab's session only.
            args += ["-e", "IS_SANDBOX=1"]
        args.append(inner)
        result = tmux(*args)
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip() or "tmux failed")
        target = f"={name}:"  # session target in pane syntax (set-option takes a pane)
        tmux("set-option", "-t", target, "@cc_mode", mode)
        tmux("set-option", "-t", target, "@cc_order", str(order))
        tmux("set-option", "-t", target, "@cc_state", "done" if mode != "shell" else "shell")
        tmux("set-option", "-t", target, "status", "off")  # the web UI shows tabs
    return {"name": name, "label": label, "mode": mode, "order": order,
            "state": "done" if mode != "shell" else "shell", "custom": False}


def rename_tab(name, label):
    if not NAME_RE.match(name):
        raise ValueError("invalid tab name")
    label = re.sub(r"[\x00-\x1f\x7f]", "", str(label or "")).strip()[:60]
    target = f"={name}:"
    if not label:
        # Empty name: go back to automatic naming (Claude / Resume / chat name).
        tmux("set-option", "-t", target, "@cc_custom", "0")
    else:
        tmux("set-option", "-t", target, "@cc_label", label)
        tmux("set-option", "-t", target, "@cc_custom", "1")
    for tab in list_tabs():
        if tab["name"] == name:
            return tab
    raise ValueError("tab not found")


def send_key(name, key):
    if not NAME_RE.match(name):
        raise ValueError("invalid tab name")
    if key not in KEYS:
        raise ValueError("unsupported key")
    tmux("send-keys", "-t", f"={name}:", KEYS[key])


def qr_svg(text):
    if not URL_RE.match(text or ""):
        raise ValueError("text must be an http(s) URL")
    result = subprocess.run(
        ["qrencode", "-t", "SVG", "-m", "2", "-l", "M", "-o", "-", text],
        capture_output=True, timeout=10,
    )
    if result.returncode != 0:
        raise RuntimeError("qrencode failed")
    return result.stdout


def close_tab(name):
    if not NAME_RE.match(name):
        raise ValueError("invalid tab name")
    tmux("kill-session", "-t", f"={name}")


class Handler(BaseHTTPRequestHandler):
    server_version = "claude-tabs"

    def log_message(self, *args):  # no request logging
        pass

    def send_json(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        url = urlparse(self.path)
        try:
            if url.path == "/api/tabs":
                self.send_json(200, list_tabs())
            elif url.path == "/api/info":
                self.send_json(200, {"phone_url": PHONE_URL})
            elif url.path == "/api/qr":
                svg = qr_svg((parse_qs(url.query).get("text") or [""])[0])
                self.send_response(200)
                self.send_header("Content-Type", "image/svg+xml")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", str(len(svg)))
                self.end_headers()
                self.wfile.write(svg)
            else:
                self.send_json(404, {"error": "not found"})
        except ValueError as err:
            self.send_json(400, {"error": str(err)})
        except Exception as err:  # noqa: BLE001
            self.send_json(500, {"error": str(err)})

    def do_POST(self):
        if self.headers.get("X-Requested-With") != "claude-tabs":
            self.send_json(403, {"error": "forbidden"})
            return
        length = min(int(self.headers.get("Content-Length") or 0), 1024)
        raw = self.rfile.read(length) if length else b"{}"
        path = self.path.split("?")[0]
        try:
            if path == "/api/tabs":
                mode = (json.loads(raw or b"{}") or {}).get("mode", "new")
                self.send_json(200, create_tab(mode))
                return
            body = {}
            if raw and raw.strip():
                body = json.loads(raw) or {}
            match = re.fullmatch(r"/api/tabs/([^/]+)/(close|rename|keys)", path)
            if match:
                name, action = match.groups()
                if action == "close":
                    close_tab(name)
                    self.send_json(200, {"ok": True})
                elif action == "rename":
                    self.send_json(200, rename_tab(name, body.get("label")))
                else:
                    send_key(name, body.get("key"))
                    self.send_json(200, {"ok": True})
                return
            self.send_json(404, {"error": "not found"})
        except ValueError as err:
            self.send_json(400, {"error": str(err)})
        except Exception as err:  # noqa: BLE001
            self.send_json(500, {"error": str(err)})


if __name__ == "__main__":
    ThreadingHTTPServer.daemon_threads = True
    ThreadingHTTPServer(LISTEN, Handler).serve_forever()
